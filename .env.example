# PostgreSQL connection
# Local: postgresql://arvbsnt@localhost:5432/momentum_edge
# Neon:  postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/momentum_edge?sslmode=require
DATABASE_URL=postgresql://arvbsnt@localhost:5432/momentum_edge

# Database target (local or neon)
DB_TARGET=local

# App settings
APP_ENV=development
LOG_LEVEL=INFO

# FastAPI CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# AWS S3 (parquet archive storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=momentum-edge-data

# Storage backend (local or s3)
STORAGE_BACKEND=local

# Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@momentumedge.in
ALERT_EMAIL=

# Fundamentals API (Phase 2)
FUNDAMENTALS_API_KEY=
